{
  "name": "interactive-classroom-modern-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:js": "esbuild src/main.jsx --bundle --minify --format=iife --platform=browser --target=chrome111,safari16.4,firefox128 --outfile=.build/app.js",
    "build:css": "tailwindcss -i src/styles.css -o .build/styles.css --minify"
  },
  "dependencies": {
    "motion": "13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3"
  }
}
