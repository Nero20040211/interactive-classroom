    {
      "id": "S1",
      "stageId": "ST1",
      "type": "orientation",
      "title": "学习导览：A* 搜索",
      "objectiveIds": [
        "O1"
      ],
      "knowledge": {
        "title": "先看这门知识要解决什么问题",
        "summary": "在状态空间很大时，盲目把所有可能路径都展开会浪费大量计算。A* 的核心是把“已经付出的代价”和“对剩余代价的估计”结合起来，优先探索看起来最有希望的节点。",
        "mentalModel": "学习 A* 搜索 时，不要先背结论。先问三个问题：研究对象是什么、哪些量或结构会发生变化、我们凭什么判断一个解释是对的。在状态空间很大时，盲目把所有可能路径都展开会浪费大量计算。A* 的核心是把“已经付出的代价”和“对剩余代价的估计”结合起来，优先探索看起来最有希望的节点。 这会把零散公式、图示或术语放回同一条推理链中。\n\n本课堂采用“讲解—例子—交互—检测”的顺序。交互不是知识本身，而是用来检验你是否真的能把规则迁移到新情境。",
        "sections": [
          {
            "title": "学习路线",
            "body": "先理解 g、h、f 三个量；再理解“可采纳”为什么要求 h 不高估；最后通过证明排序练习重建 A* 最优性论证的一条核心链。"
          },
          {
            "title": "如何使用本课堂",
            "body": "先完整读完每页知识讲解，再进入实践区。遇到公式先解释符号和单位，遇到生物过程先追踪结构与因果，遇到算法先明确状态、评价函数与停止条件。每一页都允许返回前文，并可使用左侧搜索和收藏。"
          },
          {
            "title": "进一步建立学习框架",
            "body": "搜索问题可以统一描述为状态、动作、转移代价和目标测试。真正困难的地方往往不是“能不能找到一条路”，而是在巨大状态空间中怎样把计算预算优先花在更有希望的方向。启发式函数因此不是随便给节点一个分数，而是把领域知识压缩成对未来代价的估计。理解 A* 时应同时关注算法行为和理论保证：g 记录过去，h 估计未来，f 把两者放在同一成本尺度；而可采纳性、一致性等条件决定我们能证明什么。后面的证明练习会让这些条件从术语变成真正参与推理的不等式。"
          }
        ],
        "pitfalls": [
          "把“看懂”误认为“会用”；只记结论而忽略前提；在没有明确变量、结构或证据时直接套公式。"
        ],
        "takeaway": "先建立 A* 搜索 的问题框架，再学习细节。",
        "citations": [
          {
            "sourceId": "src-aima",
            "locator": "Heuristic search / A*"
          }
        ]
      }
    },
    {
      "id": "S2",
      "stageId": "ST1",
      "type": "concept",
      "title": "A* 为什么要同时考虑过去代价与未来估计",
      "objectiveIds": [
        "O1",
        "O2"
      ],
      "knowledge": {
        "title": "把已付成本与未来估计放在同一把尺子上",
        "summary": "g(n) 是从起点到当前节点的已知路径代价，h(n) 估计从当前节点到目标的剩余代价。",
        "mentalModel": [
          {
            "text": "想象你在地图上找一条成本最低的路线。只看已经走过的代价，会偏爱目前走得短的节点；只看未来估计，又会忽略到达当前节点已经花掉的代价。A* 把这两类成本放在同一尺度上：",
            "formula": {
              "tex": "f(n)=g(n)+h(n)",
              "spoken": "f n 等于 g n 加 h n",
              "mathml": "<math display=\"block\"><mi>f</mi><mo>(</mo><mi>n</mi><mo>)</mo><mo>=</mo><mi>g</mi><mo>(</mo><mi>n</mi><mo>)</mo><mo>+</mo><mi>h</mi><mo>(</mo><mi>n</mi><mo>)</mo></math>"
            }
          },
          {
            "text": "因此评价值可以被理解为“经过当前节点完成整条路径”的一个成本估计。"
          }
        ],
        "mechanism": [
          {
            "text": "如果启发式估计从不高估真实最小剩余代价，就满足可采纳条件：",
            "formula": {
              "tex": "h(n)\\le h^*(n)",
              "spoken": "h n 小于等于 h 星 n",
              "mathml": "<math display=\"block\"><mi>h</mi><mo>(</mo><mi>n</mi><mo>)</mo><mo>≤</mo><msup><mi>h</mi><mo>*</mo></msup><mo>(</mo><mi>n</mi><mo>)</mo></math>"
            }
          },
          {
            "text": "在最优路径上的节点中，这个条件可以进一步推出评价值具有上界：",
            "formula": {
              "tex": "f(n)\\le C^*",
              "spoken": "f n 小于等于 C 星",
              "mathml": "<math display=\"block\"><mi>f</mi><mo>(</mo><mi>n</mi><mo>)</mo><mo>≤</mo><msup><mi>C</mi><mo>*</mo></msup></math>"
            }
          },
          {
            "text": "这条上界是 A* 最优性论证中的关键桥梁。"
          }
        ],
        "semanticBlocks": [
          {
            "id": "def-astar-f",
            "kind": "definition",
            "title": "A* 评价函数",
            "statement": "A* 把已付路径代价与对剩余路径代价的启发式估计相加，得到候选节点的评价值。",
            "formula": {
              "id": "eq-astar",
              "tex": "f(n)=g(n)+h(n)",
              "spoken": "f n 等于 g n 加 h n",
              "mathml": "<math display=\"block\"><mi>f</mi><mo>(</mo><mi>n</mi><mo>)</mo><mo>=</mo><mi>g</mi><mo>(</mo><mi>n</mi><mo>)</mo><mo>+</mo><mi>h</mi><mo>(</mo><mi>n</mi><mo>)</mo></math>"
            },
            "citations": [
              {
                "sourceId": "src-aima",
                "locator": "A* evaluation function"
              }
            ]
          },
          {
            "id": "def-admissible",
            "kind": "definition",
            "title": "可采纳启发式",
            "statement": "对任意节点 n，启发式估计不超过从 n 到目标的真实最小剩余代价。",
            "formula": {
              "id": "eq-admissible",
              "tex": "h(n)\\le h^*(n)",
              "spoken": "h n 小于等于真实最优剩余代价 h 星 n",
              "mathml": "<math display=\"block\"><mi>h</mi><mo>(</mo><mi>n</mi><mo>)</mo><mo>≤</mo><msup><mi>h</mi><mo>*</mo></msup><mo>(</mo><mi>n</mi><mo>)</mo></math>"
            },
            "citations": [
              {
                "sourceId": "src-aima",
                "locator": "Admissible heuristics"
              }
            ]
          },
          {
            "id": "thm-astar-bound",
            "kind": "theorem",
            "title": "最优路径节点的 f 值上界",
            "statement": "若启发式可采纳，则最优路径上的任一节点，其评价值不会超过完整最优解的总代价。",
            "proofSketch": "先由可采纳性把启发式估计替换为真实剩余代价的上界，再使用最优路径的成本分解完成比较。",
            "references": [
              "def-astar-f",
              "def-admissible"
            ],
            "citations": [
              {
                "sourceId": "src-aima",
                "locator": "A* optimality argument"
              }
            ]
          },
          {
            "id": "proof-astar-bound",
            "kind": "proof",
            "of": "thm-astar-bound",
            "strategy": "把 f 的定义与可采纳性不等式串联。",
            "steps": [
              {
                "text": "从 A* 评价函数定义开始。",
                "formula": {
                  "id": "eq-proof1",
                  "tex": "f(n)=g(n)+h(n)",
                  "spoken": "f n 等于 g n 加 h n",
                  "mathml": "<math display=\"block\"><mi>f</mi><mo>(</mo><mi>n</mi><mo>)</mo><mo>=</mo><mi>g</mi><mo>(</mo><mi>n</mi><mo>)</mo><mo>+</mo><mi>h</mi><mo>(</mo><mi>n</mi><mo>)</mo></math>"
                },
                "reason": "定义"
              },
              {
                "text": "可采纳性保证估计不高于真实剩余代价。",
                "formula": {
                  "id": "eq-proof2",
                  "tex": "h(n)\\le h^*(n)",
                  "spoken": "h n 小于等于 h 星 n",
                  "mathml": "<math display=\"block\"><mi>h</mi><mo>(</mo><mi>n</mi><mo>)</mo><mo>≤</mo><msup><mi>h</mi><mo>*</mo></msup><mo>(</mo><mi>n</mi><mo>)</mo></math>"
                },
                "reason": "可采纳启发式定义"
              },
              {
                "text": "在最优路径上，把已经发生的路径代价与真实最小剩余代价合并。",
                "reason": "不等式代入与最优路径分解",
                "formula": {
                  "tex": "g(n)+h^*(n)=C^*",
                  "spoken": "g n 加 h 星 n 等于 C 星",
                  "mathml": "<math display=\"block\"><mi>g</mi><mo>(</mo><mi>n</mi><mo>)</mo><mo>+</mo><msup><mi>h</mi><mo>*</mo></msup><mo>(</mo><mi>n</mi><mo>)</mo><mo>=</mo><msup><mi>C</mi><mo>*</mo></msup></math>"
                }
              }
            ],
            "conclusion": "所以最优路径节点的评价值具有所需的最优代价上界。",
            "references": [
              "eq-astar",
              "eq-admissible"
            ]
          }
        ],
        "sections": [
          {
            "title": "可采纳不等于“越小越好”",
            "body": [
              {
                "text": "一种极端但合法的可采纳启发式是：",
                "formula": {
                  "tex": "h(n)=0",
                  "spoken": "h n 等于零",
                  "mathml": "<math display=\"block\"><mi>h</mi><mo>(</mo><mi>n</mi><mo>)</mo><mo>=</mo><mn>0</mn></math>"
                }
              },
              {
                "text": "它不会高估未来代价，却也几乎不给搜索提供方向，因此 A* 会退化为一致代价搜索。好的启发式希望尽量接近真实剩余代价，同时保持不高估；这体现了信息量与理论保证之间的平衡。"
              }
            ]
          }
        ],
        "pitfalls": [
          "h 值大不代表一定更好；若高估可能破坏最优性保证。",
          "不同 A* 变体和图搜索还涉及一致性、重复状态处理等更细条件。"
        ],
        "takeaway": "A* 的关键不是一个公式，而是 f 的成本分解与 h 的边界条件。",
        "citations": [
          {
            "sourceId": "src-aima",
            "locator": "A* and heuristic properties"
          }
        ],
        "workedExamples": [
          {
            "id": "ex-s2",
            "title": "两个候选节点的取舍",
            "variantType": "standard",
            "text": "比较两个候选节点时，一个节点已经走过的代价较低但预计剩余代价较高，另一个相反。A* 的判断不是单看其中一项，而是把已付代价与启发式剩余估计共同纳入优先级。"
          }
        ]
      }
    },
    {
