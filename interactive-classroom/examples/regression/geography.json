  "scenes": [
    {
      "id": "GE1",
      "stageId": "ST1",
      "type": "concept",
      "title": "先把水循环理解成储库之间的转移",
      "objectiveIds": [
        "O1"
      ],
      "knowledge": {
        "title": "水循环是水在储库之间改变位置和状态的过程",
        "summary": "水循环不应该只记成“蒸发—降水”两个词。太阳能驱动地表水蒸发或植物蒸腾进入大气，水汽在适宜条件下凝结形成云滴，随后通过降水返回地表，再经径流、下渗等路径进入不同储库。学习的重点是水在海洋、大气和陆地之间如何转移，而不是把每一步看成彼此独立的图标。",
        "prerequisites": [
          "先区分对象、状态、条件和结果，并能按步骤描述变化。"
        ],
        "mentalModel": "把海洋、大气和陆地想成三个储水区，同一份水可以在不同时间进入不同储库。动画里的水滴是“追踪标记”，帮助观察一份水跨越储库；真实水循环当然是大量分子同时发生、路径也远比单个水滴复杂。",
        "mechanism": "先让水滴从海面上升，表示蒸发进入大气；再进入云区，表示水汽凝结形成云滴；随后随气团向陆地移动并下降，表示降水把水返回地表。每一步都要保留能量驱动、状态变化和储库转移的区分。",
        "workedExamples": [
          {
            "id": "水循环是水在储库之间改变位置和状态的过程-ex1",
            "variantType": "standard",
            "title": "标准：海洋—大气—陆地的一次循环路径",
            "problem": "先预测关键状态会怎样变化，再说明依据。",
            "solution": "先锁定当前对象与条件，只沿本节机制追踪状态变化。"
          },
          {
            "id": "水循环是水在储库之间改变位置和状态的过程-ex2",
            "variantType": "contrast",
            "title": "边界：并非所有水都按同一顺序快速循环",
            "problem": "如果改变一个关键条件，哪一步会首先不同？",
            "solution": "找出机制链上最先受到该条件影响的状态，再向后推演。"
          }
        ],
        "pitfalls": [
          "不要把示意图中的上升方向理解成所有蒸发水都垂直直线上升。",
          "不要把动画中的空间位置、颜色或速度直接当成真实尺度，除非课程明确说明按比例绘制。"
        ],
        "connections": [
          "把动画状态与文字定义、符号表示和练习题互相翻译。"
        ],
        "checkYourself": [
          "暂停动画后，能否不用画面说出三步机制？",
          "能否指出一个动画不能代表的真实细节？"
        ]
      }
    },
    {
      "id": "GE2",
      "stageId": "ST1",
      "type": "interactive",
      "title": "追踪一滴水跨越三个储库",
      "objectiveIds": [
        "O1",
        "O2"
      ],
      "knowledge": {
        "title": "让一滴“追踪水”跨越储库，帮助看清蒸发、凝结与降水",
        "summary": "过程动画用水滴和气团而不是抽象方框。第一步水滴位于海洋储库；第二步上升进入云区，强调从液态水到大气水汽/云滴的阶段变化；第三步气团向陆地输送，水滴随之移动；最后水滴下降进入陆地储库。动画的空间路径只是教学示意，真正需要迁移的是储库之间的通量和状态变化。",
        "prerequisites": [
          "先区分对象、状态、条件和结果，并能按步骤描述变化。"
        ],
        "mentalModel": "把水滴当成被贴上追踪标签的一小份水：你只追踪它“现在在哪个储库、以什么状态存在、下一步由什么过程转移”。气团负责表现大气输送，但不会让学生误以为云本身是一块固体物体。",
        "mechanism": "海洋、云区和陆地区域先作为容器背景出现；水滴依次进入海洋/云/陆地区域，气团在输送阶段移动。semantic relation 的 enters/contains 说明水滴进入区域属于知识语义，不应被防遮挡机制强行分开。",
        "workedExamples": [
          {
            "id": "让一滴“追踪水”跨越储库，帮助看清蒸发、凝结与降水-ex1",
            "variantType": "standard",
            "title": "标准：一次海陆水循环路径",
            "problem": "先预测关键状态会怎样变化，再说明依据。",
            "solution": "先锁定当前对象与条件，只沿本节机制追踪状态变化。"
          },
          {
            "id": "让一滴“追踪水”跨越储库，帮助看清蒸发、凝结与降水-ex2",
            "variantType": "contrast",
            "title": "对比：地下水或冰雪可以有不同停留时间",
            "problem": "如果改变一个关键条件，哪一步会首先不同？",
            "solution": "找出机制链上最先受到该条件影响的状态，再向后推演。"
          }
        ],
        "pitfalls": [
          "不要把一个水滴的单一路径当成地球上所有水的唯一循环路线。",
          "不要把动画中的空间位置、颜色或速度直接当成真实尺度，除非课程明确说明按比例绘制。"
        ],
        "connections": [
          "把动画状态与文字定义、符号表示和练习题互相翻译。"
        ],
        "checkYourself": [
          "暂停动画后，能否不用画面说出三步机制？",
          "能否指出一个动画不能代表的真实细节？"
        ]
      },
