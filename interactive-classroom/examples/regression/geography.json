    {
      "id": "GE3",
      "stageId": "ST1",
      "type": "interactive",
      "title": "把“储库转移”重新放回全球空间",
      "objectiveIds": [
        "O2"
      ],
      "knowledge": {
        "title": "过程动画解释机制，地图负责提醒空间差异真实存在",
        "summary": "水循环机制可以用一条典型路径说明，但不同地区的纬度、海陆位置和大气环流条件不同，不能把同一动画轨迹当成全球统一路径。这里用几个真实城市点只训练经纬度和空间比较：同样接近赤道的城市分布在不同经度，说明“低纬”不是单一地点；水循环的实际输送还要结合具体区域条件分析。",
        "prerequisites": [
          "会读经纬度。"
        ],
        "mentalModel": "动画像显微镜，突出一条机制链；地图像广角镜头，提醒同一种机制发生在不同空间背景中。两种表示回答不同问题。",
        "mechanism": "筛选赤道附近城市并比较经度：新加坡、基多、内罗毕纬度都接近0°，但经度相差很大。由此建立“相同纬度带≠相同空间位置”的地理判断。",
        "workedExamples": [
          {
            "id": "ge-map-ex1",
            "variantType": "standard",
            "title": "筛选赤道附近城市",
            "problem": "哪些点纬度绝对值较小？",
            "solution": "新加坡、基多、内罗毕。"
          },
          {
            "id": "ge-map-ex2",
            "variantType": "contrast",
            "title": "比较经度",
            "problem": "这些城市是否集中在同一经度？",
            "solution": "不是，它们分布在不同大陆和经度。"
          }
        ],
        "pitfalls": [
          "地图点位用于空间背景，不直接推出具体水循环强度。",
          "投影上的屏幕距离不能替代大圆距离。"
        ],
        "connections": [
          "把过程机制和地理空间背景分开建模再联系。"
        ],
        "checkYourself": [
          "同纬度是否等于同气候？为什么不能直接这样推？",
          "地图和过程动画分别回答什么问题？"
        ]
      },
