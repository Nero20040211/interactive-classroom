  "scenes": [
    {
      "id": "CS1",
      "stageId": "ST1",
      "type": "concept",
      "title": "先理解搜索区间不变量",
      "objectiveIds": [
        "O1"
      ],
      "knowledge": {
        "title": "二分查找不是“猜中间”，而是维护搜索区间不变量",
        "summary": "二分查找只适用于有序序列。每一轮都选择当前搜索区间的中点，与目标值比较；如果中点值偏小，就把左半段连同中点排除，如果偏大就排除右半段，只有相等才结束。真正需要理解的是 low、high 和 mid 如何共同定义仍可能包含目标的区间，而不是死记三行代码。",
        "prerequisites": [
          "先区分对象、状态、条件和结果，并能按步骤描述变化。"
        ],
        "mentalModel": "把数组想成一条有序街道，low 和 high 是仍允许搜索的两端，中点指针每轮只去检查街道中央。比较结果不是“往左或往右走一点”，而是一次性证明半个区间不可能包含目标，因此可以永久排除。",
        "mechanism": "目标设为 9：先检查中点 7，由于 7<9，低端收缩到右半段；再检查 11，由于 11>9，高端回缩；最后中点落在 9。动画中的指针必须真正指向当前数组格，不能只让一个标签在页面上闪烁。",
        "workedExamples": [
          {
            "id": "二分查找不是“猜中间”，而是维护搜索区间不变量-ex1",
            "variantType": "standard",
            "title": "标准：在七个有序数中找9",
            "problem": "先预测关键状态会怎样变化，再说明依据。",
            "solution": "先锁定当前对象与条件，只沿本节机制追踪状态变化。"
          },
          {
            "id": "二分查找不是“猜中间”，而是维护搜索区间不变量-ex2",
            "variantType": "contrast",
            "title": "边界：无序数组不能用相同排除逻辑",
            "problem": "如果改变一个关键条件，哪一步会首先不同？",
            "solution": "找出机制链上最先受到该条件影响的状态，再向后推演。"
          }
        ],
        "pitfalls": [
          "把 mid 当成固定位置，而忘记它要随 low/high 更新。",
          "不要把动画中的空间位置、颜色或速度直接当成真实尺度，除非课程明确说明按比例绘制。"
        ],
        "connections": [
          "把动画状态与文字定义、符号表示和练习题互相翻译。"
        ],
        "checkYourself": [
          "暂停动画后，能否不用画面说出三步机制？",
          "能否指出一个动画不能代表的真实细节？"
        ]
      }
    },
    {
      "id": "CS2",
      "stageId": "ST1",
      "type": "interactive",
      "title": "让指针真正指向每一轮中点",
      "objectiveIds": [
